DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret

POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
BACKEND_REDIS_PASSWORD=replace-with-a-long-url-safe-password
CACHE_PUBLIC_PREFIX=public
CACHE_PRIVATE_PREFIX=private
DIGIKALA_RUNTIME_ROOT=/var/lib/uzshop/digikala
# Version-controlled approved category mappings used by listing jobs.
DIGIKALA_CATEGORY_MAPPING_PATH=/app/core/management/data/digikala_category_mappings.json
NOTIFICATIONS_ALLOW_FAKE_SMS=True
# Development-only deterministic confirmations. Never enable these in production.
CONFIRMED_REQUEST_DEV_MODE=True
CONFIRMED_REQUEST_DEV_CODE=123456

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=secret
MONGO_DB_NAME=uzshop

# Set these to the host user's numeric IDs on Linux.
UID=1000
GID=1000
APP_NETWORK_NAME=uzshop-app

# Must match infra/minio/.env. These are the bucket-scoped application
# credentials, not the MinIO root credentials.
MINIO_NETWORK_NAME=uzshop-storage
STORAGE_BACKEND=storages.backends.s3.S3Storage
STORAGE_ACCESS_KEY_ID=replace-with-application-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-random-application-secret
STORAGE_BUCKET_NAME=uzshop-media
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000/uzshop-media
STORAGE_REGION_NAME=us-east-1
STORAGE_ADDRESSING_STYLE=path
STORAGE_QUERYSTRING_AUTH=False
STORAGE_FILE_OVERWRITE=False
FILE_STORAGE_ALIASES=default
